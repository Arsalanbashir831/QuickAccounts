# Local development only. Copy to .env and replace the placeholder secrets.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-unique-random-string-of-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Docker Compose publishes PostgreSQL on localhost:55432.
DATABASE_URL=postgresql://quickaccounts_runtime:runtime-development-only@localhost:55432/quickaccounts
DATABASE_MIGRATION_URL=postgresql://quickaccounts_owner:owner-development-only@localhost:55432/quickaccounts
# Create the quickaccounts_platform login and apply deploy/vps/grant-platform.sql first.
DATABASE_PLATFORM_URL=postgresql://quickaccounts_platform:replace-with-local-platform-password@localhost:55432/quickaccounts

REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1
ERP_PRODUCT_CODE=quickaccounts
JWT_SIGNING_KEY=replace-with-a-different-random-string-of-at-least-40-characters
